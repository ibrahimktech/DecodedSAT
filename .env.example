# Template for local environment variables. Copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed. This file is the ONLY
# `.env*` file that is tracked, and it must never contain a real value.
#
# Prefix a variable with NEXT_PUBLIC_ only if it is genuinely safe to ship to
# the browser — that prefix inlines the value into the client bundle. API keys,
# tokens, and credentials never get it; they stay server-only and are reached
# through a route handler or server action that proxies the request.


# --- URLs --------------------------------------------------------------------
# Two variables, not one, because the landing page and the dashboard are
# becoming separate deployments (dashboard -> app.<domain>.com). Neither is
# hardcoded anywhere in the code: shipping the real domain is an env change on
# Vercel and nothing else.

# This deployment's origin. Every /auth/* route lives here, so it is also the
# base for the email confirmation link. Public by definition — it appears in
# metadata and og:url.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where a signed-in user is sent. Used verbatim, never appended to, so it may
# carry a path today and become a bare origin later:
#   local     http://localhost:3000/dashboard
#   later     https://app.<domain>.com
NEXT_PUBLIC_APP_URL=http://localhost:3000/dashboard


# --- Supabase ----------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
#
# The anon key is browser-safe and is the correct key for this flow. It grants
# nothing on its own; Row Level Security is the access boundary.


NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key bypasses RLS entirely — server-only, forever, and never
# NEXT_PUBLIC_. Unused by the auth flow (signup needs no admin bypass); listed
# so that whoever needs it later adds it here rather than inventing a name.
# SUPABASE_SERVICE_ROLE_KEY=


# --- Cloudflare Turnstile ----------------------------------------------------
# Only the SITE key belongs in this app — it is rendered into the widget markup
# and is public by design.
#
# The Turnstile SECRET key is not listed here on purpose. It goes into the
# Supabase dashboard (Authentication -> Attack Protection -> CAPTCHA), because
# Supabase is what verifies the token. Turnstile tokens are single-use, so
# verifying in this app as well would consume the token and make Supabase's own
# check fail.
#
# The default below is Cloudflare's public "always passes" test key, so signup
# works locally without a Cloudflare account. Replace it with a real site key
# before deploying. Match it in Supabase with the paired test secret
# (1x0000000000000000000000000000000AA) or captcha verification will reject it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# --- Desmos graphing calculator ----------------------------------------------
# Free key from https://www.desmos.com/api — sign in, then "Get an API key".
#
# NEXT_PUBLIC_ is correct here, and this is the ONLY new public variable in
# step 7. The Desmos key is a domain-scoped identifier that gates nothing but
# which sites may embed the calculator; it is rendered into a <script> src by
# design. It is not a credential in the sense the Supabase service role key is,
# and the reasoning for one must never be used to justify the other.
#
# Leave it unset and the calculator simply does not appear: no script tag, no
# toggle button, no console errors, and practice works exactly as it does now.
# Setting it later is an environment change and no code change.
NEXT_PUBLIC_DESMOS_API_KEY=


# --- Rate limiting -----------------------------------------------------------
# Server-only. Upstash Redis REST credentials (console.upstash.com -> your
# database -> REST API).
#
# Optional locally: with these unset, rate limiting falls back to an in-process
# window that is fine for `npm run dev`. In production they are required — the
# app throws on startup without them, because serverless invocations do not
# share memory and a per-process counter gives an attacker a fresh budget on
# every cold instance. See the guard in src/lib/rate-limit.ts.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Auth rate limits (optional) ---------------------------------------------
# Each overrides a default that is set in code for a production surface. Leave
# them unset in production; the defaults are the intended values there.
#
# Set them in .env.local (gitignored) when you need to create a lot of test
# accounts or sign in repeatedly without the limiter getting in the way. A
# non-numeric or zero value is ignored with a warning, never obeyed.
#
# RATE_LIMIT_SIGNUP        signups per IP per 15 min          (default 60)
# RATE_LIMIT_LOGIN_IP      sign-ins per IP per 10 min         (default 100)
# RATE_LIMIT_LOGIN_ACCOUNT sign-ins per account per 15 min    (default 25)
# RATE_LIMIT_AUTH_CALLBACK confirmation redemptions per IP per 10 min (default 20)
#
# NOTE: these govern THIS APP only. Supabase applies its own limits on top —
# in particular a default of 2 confirmation emails per hour, which is a project
# setting in the Supabase dashboard and cannot be raised from here.
